# ---------------------------------------------------------------------------
# Career Economics Lab — environment template
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
#
# Phase 1 (current) needs NONE of these: the site reads career content from
# version-controlled files under content/careers/. Everything below is declared
# ahead of the phase that introduces it so the surface is reviewable now.
# ---------------------------------------------------------------------------

# Public canonical origin. Used for metadata, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2: Supabase -----------------------------------------------------
# The anon key is public by design and only ever grants row-level-security
# scoped read access to `published` career rows.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by seed/migration scripts. Must never reach the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 6: analytics ----------------------------------------------------
# Cookieless, no personal data. Left unset = analytics disabled.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Phase 7: optional AI assistant ---------------------------------------
# The product must remain fully usable with the assistant switched off.
# NEXT_PUBLIC_FEATURE_AI_ASSISTANT=false
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_DAILY_BUDGET_EUR=1
